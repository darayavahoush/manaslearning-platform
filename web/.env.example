# Video link shown in invites (Google Meet / Zoom room). Replace with the real one.
MEETING_URL=
MAIL_FROM=
MAIL_FROM_ADDRESS=
# Leave SMTP_HOST empty to write emails to data/outbox instead of sending
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Team login (required in production) ---
# Long random string used to sign team session tokens (16+ chars). Generate: openssl rand -hex 32
SESSION_SECRET=
# Password for the Clinic Administrator login. Admin login is disabled in production until this is set.
TEAM_ADMIN_PASSWORD=

# --- Payments (same Paytm merchant account as the main site; values live in Azure Key Vault there) ---
# Leave PAYTM_MID/PAYTM_MKEY empty in local dev to use the built-in test payment page.
PAYTM_MID=
PAYTM_MKEY=
# WEBSTAGING for stage, DEFAULT (or your merchant's website name) for production
PAYTM_WEBSITE=
# Set to "stage" to use securegw-stage.paytm.in
PAYTM_ENV=
# Public https URL of this app. Paytm sends the parent back to SITE_URL/api/pay/callback
SITE_URL=

# --- Reminders (1 hour before: email + SMS) ---
# Shared secret for /api/cron/reminders (also set as a GitHub secret for the schedule)
CRON_SECRET=
# SMS: msg91 (needs a DLT-approved template) or twilio
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# --- Storage (required on Vercel; leave empty locally to use data/db.json) ---
# Azure Storage account connection string. Vercel's disk is read-only, so production needs this.
AZURE_STORAGE_CONNECTION_STRING=
# Optional. Private container that holds db.json (created automatically). Default: manas-data
AZURE_STORAGE_CONTAINER=
